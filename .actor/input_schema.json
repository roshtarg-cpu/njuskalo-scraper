{
  "title": "Njuškalo Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "category": {
      "type": "string",
      "title": "📂 Category",
      "description": "Main category to scrape (auto-moto, nekretnine/real-estate, poslovi/jobs, elektronika, etc.)",
      "prefill": "auti",
      "editor": "select",
      "enum": ["auti", "nekretnine", "poslovi", "elektronika", "odijeca-obuća", "sport-fitness", "kućanski-aparati", "namještaj", "sve-kategorije"],
      "enumTitles": ["🚗 Auti (Cars)", "🏠 Nekretnine (Real Estate)", "💼 Poslovi (Jobs)", "📱 Elektronika (Electronics)", "👔 Odjeća & Obuća (Clothing)", "⚽ Sport & Fitness", "🏡 Kućanski Aparati (Appliances)", "🛋️ Namještaj (Furniture)", "📋 All Categories"]
    },
    "searchQuery": {
      "type": "string",
      "title": "🔍 Search Keywords",
      "description": "Search term to filter listings (optional, leave empty for all)",
      "prefill": "",
      "editor": "textfield"
    },
    "location": {
      "type": "string",
      "title": "📍 Location",
      "description": "Filter by city or region (Zagreb, Split, Rijeka, Osijek, etc.)",
      "prefill": "Zagreb",
      "editor": "textfield"
    },
    "priceMin": {
      "type": "integer",
      "title": "💰 Minimum Price (HRK)",
      "description": "Minimum price in Croatian Kuna/EUR (optional)",
      "prefill": 0,
      "editor": "number",
      "minimum": 0
    },
    "priceMax": {
      "type": "integer",
      "title": "💰 Maximum Price (HRK)",
      "description": "Maximum price in Croatian Kuna/EUR (optional)",
      "prefill": 100000,
      "editor": "number",
      "minimum": 0
    },
    "condition": {
      "type": "string",
      "title": "✨ Item Condition",
      "description": "Filter by item condition",
      "prefill": "Any",
      "editor": "select",
      "enum": ["Any", "novo", "rabljeno", "oštećeno"],
      "enumTitles": ["Any Condition", "Novo (New)", "Rabljeno (Used)", "Oštećeno (Damaged)"]
    },
    "sortBy": {
      "type": "string",
      "title": "🔃 Sort Order",
      "description": "How to sort results",
      "prefill": "datum-silazno",
      "editor": "select",
      "enum": ["datum-silazno", "datum-uzlazno", "cijena-silazno", "cijena-uzlazno"],
      "enumTitles": ["📅 Newest First", "📅 Oldest First", "💰 Highest Price", "💰 Lowest Price"]
    },
    "includeDescription": {
      "type": "boolean",
      "title": "📝 Include Full Descriptions",
      "description": "Extract complete listing descriptions (slower but more detailed)",
      "prefill": true,
      "editor": "checkbox"
    },
    "maxResults": {
      "type": "integer",
      "title": "🔢 Max Results",
      "description": "Maximum number of listings to scrape",
      "default": 50,
      "prefill": 20,
      "minimum": 1,
      "maximum": 1000,
      "editor": "number"
    },
    "proxyConfiguration": {
      "type": "object",
      "title": "🌐 Proxy Configuration",
      "description": "Use Apify residential proxies for reliable extraction (recommended)",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      },
      "editor": "proxy"
    }
  },
  "required": ["category", "maxResults"]
}
